{
  "name": "md-viz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @md-viz/web dev",
    "dev:all": "pnpm --parallel --filter @md-viz/cache --filter @md-viz/web --filter @md-viz/electron dev",
    "dev:design": "pnpm --filter @md-viz/design dev",
    "dev:electron": "pnpm --filter @md-viz/electron dev",
    "dev:cache": "pnpm --filter @md-viz/cache dev",
    "generate": "pnpm --filter @md-viz/api-client generate",
    "openapi": "pnpm --filter @md-viz/cache openapi",
    "build": "pnpm generate && pnpm -r build",
    "typecheck": "pnpm generate && pnpm -r typecheck",
    "test": "pnpm generate && pnpm -r test",
    "lint": "pnpm generate && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "pnpm generate && pnpm -r --workspace-concurrency=1 --no-bail coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
