{
  "openapi": "3.1.0",
  "info": {
    "title": "md-viz note cache",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ]
      },
      "UpsertResult": {
        "type": "object",
        "properties": {
          "upserted": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "upserted"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "UpsertBody": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteInput"
            }
          }
        },
        "required": [
          "notes"
        ]
      },
      "NoteInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/]+$",
            "description": "client-chosen note id",
            "example": "abc123"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "string fields by name",
            "example": {
              "title": "plan",
              "body": "raised beds"
            }
          }
        },
        "required": [
          "id",
          "fields"
        ]
      },
      "NoteRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/]+$",
            "description": "client-chosen note id",
            "example": "abc123"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "string fields by name",
            "example": {
              "title": "plan",
              "body": "raised beds"
            }
          }
        },
        "required": [
          "id",
          "fields"
        ]
      },
      "Note": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "string fields by name",
            "example": {
              "title": "plan",
              "body": "raised beds"
            }
          }
        },
        "required": [
          "fields"
        ]
      },
      "ReplaceSetResult": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "count"
        ]
      },
      "ReplaceSetBody": {
        "type": "object",
        "properties": {
          "noteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "client-chosen note id",
              "example": "abc123"
            }
          }
        },
        "required": [
          "noteIds"
        ]
      },
      "SetSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/]+$",
            "description": "set id, namespaced by source",
            "example": "bear:created-today"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "updated": {
            "type": "string",
            "description": "ISO time the set was last replaced"
          }
        },
        "required": [
          "id",
          "count",
          "updated"
        ]
      },
      "Set": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/]+$",
            "description": "set id, namespaced by source",
            "example": "bear:created-today"
          },
          "updated": {
            "type": "string",
            "description": "ISO time the set was last replaced"
          },
          "noteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "client-chosen note id",
              "example": "abc123"
            }
          }
        },
        "required": [
          "id",
          "updated",
          "noteIds"
        ]
      },
      "TagColors": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagColor"
            }
          }
        },
        "required": [
          "tags"
        ]
      },
      "TagColor": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1,
            "description": "a note tag, as written in the notes",
            "example": "work/q4"
          },
          "color": {
            "type": "integer",
            "minimum": 0,
            "description": "index into the note palette",
            "example": 3
          }
        },
        "required": [
          "tag",
          "color"
        ]
      },
      "AddTagColorsResult": {
        "type": "object",
        "properties": {
          "added": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "added"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "liveness check",
        "responses": {
          "200": {
            "description": "service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/notes": {
      "put": {
        "operationId": "upsertNotes",
        "summary": "upsert a batch of notes; only the named fields are written",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "number of notes upserted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpsertResult"
                }
              }
            }
          },
          "400": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listNotes",
        "summary": "list notes with the requested fields, ordered by id",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "comma-separated field names to include",
              "example": "title,synced"
            },
            "required": true,
            "description": "comma-separated field names to include",
            "name": "fields",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "one row per note",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NoteRow"
                  }
                }
              }
            }
          },
          "400": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/notes/{id}": {
      "get": {
        "operationId": "getNote",
        "summary": "all fields of one note",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "client-chosen note id",
              "example": "abc123"
            },
            "required": true,
            "description": "client-chosen note id",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "the note",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "404": {
            "description": "unknown note",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteNote",
        "summary": "remove a note; succeeds even if it did not exist",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "client-chosen note id",
              "example": "abc123"
            },
            "required": true,
            "description": "client-chosen note id",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "note removed"
          }
        }
      }
    },
    "/sets/{id}": {
      "put": {
        "operationId": "replaceSet",
        "summary": "replace the note ids of a set, creating it if needed",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "set id, namespaced by source",
              "example": "bear:created-today"
            },
            "required": true,
            "description": "set id, namespaced by source",
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceSetBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "number of notes in the set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplaceSetResult"
                }
              }
            }
          },
          "400": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getSet",
        "summary": "the note ids of one set",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "set id, namespaced by source",
              "example": "bear:created-today"
            },
            "required": true,
            "description": "set id, namespaced by source",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "the set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Set"
                }
              }
            }
          },
          "404": {
            "description": "unknown set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSet",
        "summary": "remove a set; succeeds even if it did not exist",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "set id, namespaced by source",
              "example": "bear:created-today"
            },
            "required": true,
            "description": "set id, namespaced by source",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "set removed"
          }
        }
      }
    },
    "/sets": {
      "get": {
        "operationId": "listSets",
        "summary": "list sets with their note counts, ordered by id",
        "responses": {
          "200": {
            "description": "one row per set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SetSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tag-colors": {
      "get": {
        "operationId": "listTagColors",
        "summary": "the color index of every tag, ordered by tag",
        "responses": {
          "200": {
            "description": "one row per tag",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagColors"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "addTagColors",
        "summary": "give tags a color index; a tag that has one keeps it",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TagColors"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "number of tags that had no color yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddTagColorsResult"
                }
              }
            }
          },
          "400": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
