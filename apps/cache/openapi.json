{
  "openapi": "3.1.0",
  "info": {
    "title": "md-viz note cache",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ]
      },
      "UpsertResult": {
        "type": "object",
        "properties": {
          "upserted": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "upserted"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "UpsertBody": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteInput"
            }
          }
        },
        "required": [
          "notes"
        ]
      },
      "NoteInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/]+$",
            "description": "client-chosen note id",
            "example": "abc123"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "string fields by name",
            "example": {
              "title": "plan",
              "body": "raised beds"
            }
          }
        },
        "required": [
          "id",
          "fields"
        ]
      },
      "NoteRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^/]+$",
            "description": "client-chosen note id",
            "example": "abc123"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "string fields by name",
            "example": {
              "title": "plan",
              "body": "raised beds"
            }
          }
        },
        "required": [
          "id",
          "fields"
        ]
      },
      "Note": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "string fields by name",
            "example": {
              "title": "plan",
              "body": "raised beds"
            }
          }
        },
        "required": [
          "fields"
        ]
      },
      "ReplaceSetResult": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "count"
        ]
      },
      "ReplaceSetBody": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "where the notes come from",
            "example": "bear"
          },
          "grouping": {
            "type": "string",
            "minLength": 1,
            "description": "the facet the set belongs to",
            "example": "tags"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "set name within its grouping",
            "example": "daily"
          },
          "color": {
            "type": "integer",
            "minimum": 0,
            "description": "index into the note palette; not interpreted",
            "example": 3
          },
          "rank": {
            "type": "integer",
            "description": "order within the grouping, lower first; not interpreted",
            "example": 0
          },
          "noteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "client-chosen note id",
              "example": "abc123"
            }
          }
        },
        "required": [
          "source",
          "grouping",
          "id",
          "color",
          "rank",
          "noteIds"
        ]
      },
      "SetSummary": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "where the notes come from",
            "example": "bear"
          },
          "grouping": {
            "type": "string",
            "minLength": 1,
            "description": "the facet the set belongs to",
            "example": "tags"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "set name within its grouping",
            "example": "daily"
          },
          "color": {
            "type": "integer",
            "minimum": 0,
            "description": "index into the note palette; not interpreted",
            "example": 3
          },
          "rank": {
            "type": "integer",
            "description": "order within the grouping, lower first; not interpreted",
            "example": 0
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "updated": {
            "type": "string",
            "description": "ISO time the set was last replaced"
          }
        },
        "required": [
          "source",
          "grouping",
          "id",
          "color",
          "rank",
          "count",
          "updated"
        ]
      },
      "Set": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "where the notes come from",
            "example": "bear"
          },
          "grouping": {
            "type": "string",
            "minLength": 1,
            "description": "the facet the set belongs to",
            "example": "tags"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "set name within its grouping",
            "example": "daily"
          },
          "color": {
            "type": "integer",
            "minimum": 0,
            "description": "index into the note palette; not interpreted",
            "example": 3
          },
          "rank": {
            "type": "integer",
            "description": "order within the grouping, lower first; not interpreted",
            "example": 0
          },
          "updated": {
            "type": "string",
            "description": "ISO time the set was last replaced"
          },
          "noteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "client-chosen note id",
              "example": "abc123"
            }
          }
        },
        "required": [
          "source",
          "grouping",
          "id",
          "color",
          "rank",
          "updated",
          "noteIds"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "liveness check",
        "responses": {
          "200": {
            "description": "service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/notes": {
      "put": {
        "operationId": "upsertNotes",
        "summary": "upsert a batch of notes; only the named fields are written",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "number of notes upserted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpsertResult"
                }
              }
            }
          },
          "400": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listNotes",
        "summary": "list notes with the requested fields, ordered by id; deleted notes only for grouping=sync",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "comma-separated field names to include",
              "example": "title,synced"
            },
            "required": true,
            "description": "comma-separated field names to include",
            "name": "fields",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "the facet the notes are loaded for; only \"sync\" includes deleted notes (see their deleted field)",
              "example": "tags"
            },
            "required": false,
            "description": "the facet the notes are loaded for; only \"sync\" includes deleted notes (see their deleted field)",
            "name": "grouping",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "one row per note",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NoteRow"
                  }
                }
              }
            }
          },
          "400": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/notes/{id}": {
      "get": {
        "operationId": "getNote",
        "summary": "all fields of one note; a deleted note is not found",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "client-chosen note id",
              "example": "abc123"
            },
            "required": true,
            "description": "client-chosen note id",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "the note",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "404": {
            "description": "unknown note",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteNote",
        "summary": "mark a note deleted (it stays in the cache); succeeds even if it did not exist",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[^/]+$",
              "description": "client-chosen note id",
              "example": "abc123"
            },
            "required": true,
            "description": "client-chosen note id",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "note removed"
          }
        }
      }
    },
    "/sets": {
      "put": {
        "operationId": "replaceSet",
        "summary": "replace the colour, rank and note ids of a set, creating it if needed",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceSetBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "number of notes in the set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplaceSetResult"
                }
              }
            }
          },
          "400": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listSets",
        "summary": "list sets with their note counts, ordered by source, grouping, rank and id",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "only sets of this source"
            },
            "required": false,
            "description": "only sets of this source",
            "name": "source",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "only sets of this grouping"
            },
            "required": false,
            "description": "only sets of this grouping",
            "name": "grouping",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "one row per set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SetSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/set": {
      "get": {
        "operationId": "getSet",
        "summary": "the note ids of one set",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "where the notes come from",
              "example": "bear"
            },
            "required": true,
            "description": "where the notes come from",
            "name": "source",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "the facet the set belongs to",
              "example": "tags"
            },
            "required": true,
            "description": "the facet the set belongs to",
            "name": "grouping",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "set name within its grouping",
              "example": "daily"
            },
            "required": true,
            "description": "set name within its grouping",
            "name": "id",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "the set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Set"
                }
              }
            }
          },
          "404": {
            "description": "unknown set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSet",
        "summary": "remove a set; succeeds even if it did not exist",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "where the notes come from",
              "example": "bear"
            },
            "required": true,
            "description": "where the notes come from",
            "name": "source",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "the facet the set belongs to",
              "example": "tags"
            },
            "required": true,
            "description": "the facet the set belongs to",
            "name": "grouping",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "set name within its grouping",
              "example": "daily"
            },
            "required": true,
            "description": "set name within its grouping",
            "name": "id",
            "in": "query"
          }
        ],
        "responses": {
          "204": {
            "description": "set removed"
          }
        }
      }
    }
  },
  "webhooks": {}
}
